# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
# (uv.lock is tracked on purpose for reproducible installs)
.uv/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Experiment artifacts / model checkpoints / logs
*.pt
*.pth
*.ckpt
*.npy
*.npz
# Run directories: the bulk is ignored (raw per-step diagnostics ~180 MB/run,
# checkpoints, window matrices, videos, analysis-tick figures) but the small
# reproducibility set every results notebook reads is tracked, so a fresh
# checkout renders every figure without the raw data. Checkpoints + videos
# travel as release assets (experiments/stable_baselines_3/src/run_assets.py).
**/runs/**
!**/runs/**/
!**/runs/**/config.yaml
!**/runs/**/rewards.csv
!**/runs/**/eval.csv
!**/runs/**/rank_stats.csv
!**/runs/**/hankel_sweep.csv
!**/runs/**/window_hankel.csv
!**/runs/**/diag_binned_*.npz
outputs/
wandb/
mlruns/
lightning_logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# AI developed experimental stuff 
.claude
claude

results_viewer_app/
# PPO benchmark caches (reproducible from config_ppo.yaml)
experiments/*/results_ppo/
# HR-DQN benchmark caches (reproducible via exp1_hankel.ipynb)
results_hankel/
results_recurrence/

# Vendored world-model repos cloned for the Krull comparison (see
# experiments/atari/dqn_krull/exp_worldmodel_krull_comparison.ipynb for the
# clone commands + pinned commits) — third-party trees with their own .git
**/cached/external/
