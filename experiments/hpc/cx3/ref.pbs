#!/bin/bash
# CX3 array job — EfficientRainbow +/- FHR NOTEBOOK-REF protocol (27 games x
# {baseline, exp3} x seeds 1-4; seed 0 exists from the notebook's 1-seed pass
# -> 5-seed pooled mean). One array index = one PACK of jobs_ref.txt lines.
#
#   python experiments/hpc/cx3/make_jobs.py --mode ref
#   cd experiments/hpc/cx3/logs        # .o/.e files collect here
#   qsub -J 1-<ceil(N/2)>%12 ../ref.pbs      # N printed by make_jobs; %12 = user GPU cap
#
# Resubmission after a partial pass: regenerate with --skip-existing first.
# Repo path / conda env override:  qsub -v REPO=...,CONDA_ENV=... -J ... ../ref.pbs
#PBS -l select=1:ncpus=4:mem=24gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=02:00:00

set -euo pipefail
REPO=${REPO:-$HOME/Low-Rank-RL-TL}
CONDA_ENV=${CONDA_ENV:-low-rank-rl}

# conda: user-local miniforge if present, else the RCS module
if [ -x "$HOME/miniforge3/bin/conda" ]; then
    eval "$("$HOME/miniforge3/bin/conda" shell.bash hook)"
else
    source /etc/profile.d/modules.sh 2>/dev/null || true
    module load Miniforge3/24.11.3-0 2>/dev/null || module load miniforge/3
    eval "$(conda shell.bash hook)"
fi
conda activate "$CONDA_ENV"
export PYTHONUNBUFFERED=1 MPLBACKEND=Agg TQDM_DISABLE=1
export OMP_NUM_THREADS=2 MKL_NUM_THREADS=2   # per packed run (4 cores / PACK 2)

cd "$REPO"
# PACK runs share this job's single GPU (default 2; PACK=1 restores
# one-run-per-GPU; override: qsub -v PACK=3 ...). Array size must be
# ceil(n_jobs / PACK) — make_jobs.py prints the right qsub line.
bash experiments/hpc/cx3/run_pack.sh \
     experiments/hpc/cx3/jobs_ref.txt "$PBS_ARRAY_INDEX" "${PACK:-2}"
